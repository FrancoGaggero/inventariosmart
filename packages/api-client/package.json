{
  "name": "@inventariosmart/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente TypeScript tipado generado desde docs/openapi.json",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "openapi-typescript ../../docs/openapi.json -o src/generated/schema.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
