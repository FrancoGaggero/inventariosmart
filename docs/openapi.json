{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "summary": "Estado de la API y de la conexión a la base de datos",
        "tags": [
          "sistema"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin token o token inválido: { code: \"NO_AUTENTICADO\" }"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Identidad del usuario autenticado",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "InventarioSmart API",
    "description": "API REST de InventarioSmart. Todas las rutas salvo /health requieren `Authorization: Bearer <ID token de Firebase>`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "Resultado de SELECT 1 contra PostgreSQL"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "db",
          "version",
          "timestamp"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "description": "Identificador del usuario en Firebase"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "uid",
          "email"
        ]
      }
    }
  }
}
