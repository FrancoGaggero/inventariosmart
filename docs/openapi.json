  "info": {
    "title": "InventarioSmart API",
    "description": "API REST de InventarioSmart. Todas las rutas salvo /health requieren `Authorization: Bearer <ID token de Firebase>`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "description": "Resultado de SELECT 1 contra PostgreSQL"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "db",
          "version",
          "timestamp"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "SIN_PERMISO",
            "enum": [
              "NO_AUTENTICADO",
              "SIN_PERMISO",
              "PLAN_REQUERIDO",
              "NO_ENCONTRADO",
              "CONFLICTO",
              "VALIDACION",
              "ERROR_INTERNO"
            ]
          },
          "message": {
            "type": "string",
            "example": "No tenés permiso para realizar esta acción."
          },
          "details": {
            "type": "object",
            "description": "Detalle adicional: campo → mensaje, o planMinimo."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "ana@repuestoscarlos.com.ar"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "rol": {
            "type": "string",
            "enum": [
              "DUENIO",
              "EMPLEADO",
              "CONTADOR"
            ]
          },
          "activo": {
            "type": "boolean"
          },
          "estado": {
            "type": "string",
            "enum": [
              "INVITADO",
              "ACTIVO",
              "INACTIVO"
            ],
            "description": "INVITADO: todavía no inició sesión; ACTIVO; INACTIVO: dado de baja"
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "nombre",
          "rol",
          "activo",
          "estado",
          "creadoEn"
        ]
      },
      "ComercioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string",
            "example": "Repuestos Carlos"
          },
          "cuit": {
            "type": "string",
            "nullable": true,
            "example": "20123456789"
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "PREMIUM"
            ]
          },
          "ivaDefault": {
            "type": "string",
            "description": "Alícuota de IVA por defecto (%), decimal como string",
            "example": "21"
          },
          "moneda": {
            "type": "string",
            "example": "ARS"
          },
          "onboardingPendiente": {
            "type": "boolean",
            "description": "true hasta que el dueño confirma el nombre del comercio"
          }
        },
        "required": [
          "id",
          "nombre",
          "cuit",
          "plan",
          "ivaDefault",
          "moneda",
          "onboardingPendiente"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "$ref": "#/components/schemas/UsuarioDto"
          },
          "comercio": {
            "$ref": "#/components/schemas/ComercioDto"
          },
          "rol": {
            "type": "string",
            "enum": [
              "DUENIO",
              "EMPLEADO",
              "CONTADOR"
            ]
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "PREMIUM"
            ]
          },
          "onboardingPendiente": {
            "type": "boolean",
            "description": "true si falta confirmar el nombre del comercio"
          }
        },
        "required": [
          "usuario",
          "comercio",
          "rol",
          "plan",
          "onboardingPendiente"
        ]
      },
      "OnboardingBodyDto": {
        "type": "object",
        "properties": {
          "nombreComercio": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Repuestos Carlos"
          }
        },
        "required": [
          "nombreComercio"
        ]
      },
      "ComercioPatchBodyDto": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "cuit": {
            "type": "string",
            "nullable": true,
            "description": "11 dígitos sin guiones, o null"
          },
          "ivaDefault": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 21
          }
        }
      },
      "InvitacionBodyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@repuestoscarlos.com.ar"
          },
          "rol": {
            "type": "string",
            "enum": [
              "DUENIO",
              "EMPLEADO",
              "CONTADOR"
            ]
          }
        },
        "required": [
          "email",
          "rol"
        ]
      },
      "UsuarioPatchBodyDto": {
        "type": "object",
        "properties": {
          "rol": {
            "type": "string",
            "enum": [
              "DUENIO",
              "EMPLEADO",
              "CONTADOR"
            ]
          },
          "activo": {
            "type": "boolean",
            "description": "false = dar de baja; true = reactivar"
          }
        }
      },
      "ProductoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "codigo": {
            "type": "string",
            "example": "FA-220"
          },
          "nombre": {
            "type": "string",
            "example": "Filtro Aire FA-220"
          },
          "categoria": {
            "type": "string",
            "nullable": true,
            "example": "Repuestos"
          },
          "precioVenta": {
            "type": "string",
            "description": "Precio de venta con IVA incluido, decimal como string",
            "example": "3900.00"
          },
          "alicuotaIva": {
            "type": "string",
            "description": "Alícuota de IVA (%)",
            "example": "21"
          },
          "costoReposicion": {
            "type": "string",
            "description": "Costo de reposición sin IVA. Omitido para el rol EMPLEADO.",
            "example": "2340.00"
          },
          "stockActual": {
            "type": "number",
            "example": 47
          },
          "stockSeguridad": {
            "type": "number",
            "example": 10
          },
          "estadoStock": {
            "type": "string",
            "enum": [
              "SIN_STOCK",
              "BAJO",
              "OK"
            ]
          },
          "activo": {
            "type": "boolean"
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          },
          "actualizadoEn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "codigo",
          "nombre",
          "categoria",
          "precioVenta",
          "alicuotaIva",
          "stockActual",
          "stockSeguridad",
          "estadoStock",
          "activo",
          "creadoEn",
          "actualizadoEn"
        ]
      },
      "ListaProductosDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductoDto"
            }
          },
          "siguienteCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor de la página siguiente o null"
          }
        },
        "required": [
          "items",
          "siguienteCursor"
        ]
      },
      "ProductoCreateBodyDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "maxLength": 64,
            "example": "FA-220"
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Filtro Aire FA-220"
          },
          "categoria": {
            "type": "string",
            "nullable": true,
            "maxLength": 60
          },
          "precioVenta": {
            "type": "string",
            "description": "Con IVA incluido; número o string decimal",
            "example": "3900.00"
          },
          "alicuotaIva": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Default: IVA del comercio"
          },
          "costoReposicion": {
            "type": "string",
            "description": "Sin IVA; número o string decimal",
            "example": "2340.00"
          },
          "stockInicial": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "stockSeguridad": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "codigo",
          "nombre",
          "precioVenta",
          "costoReposicion"
        ]
      },
      "ProductoPatchBodyDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "maxLength": 64
          },
          "nombre": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "categoria": {
            "type": "string",
            "nullable": true,
            "maxLength": 60
          },
          "precioVenta": {
            "type": "string",
            "example": "3990.00"
          },
          "alicuotaIva": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "costoReposicion": {
            "type": "string",
            "example": "2400.00"
          },
          "stockSeguridad": {
            "type": "number",
            "minimum": 0
          },
          "activo": {
            "type": "boolean",
            "description": "true reactiva un producto dado de baja"
          }
        }
      }
    }
  }
}
