# Copiar a .env (ignorado por git). Todas las variables VITE_* se exponen al navegador.

# URL base de la API (sin barra final). En Vercel apunta al servicio de Render.
VITE_API_URL=http://localhost:3000

# Configuración web de Firebase (Configuración del proyecto → Tus apps → app web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
