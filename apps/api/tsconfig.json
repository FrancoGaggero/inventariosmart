{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "removeComments": true,
    "incremental": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "prisma.config.ts"]
}
