// InventarioSmart — esquema de datos.
// Comercio (tenant), Usuario, Producto (HU-01), Movimiento (HU-10), Proveedor y PrecioProveedor
// (HU-02), Gasto (HU-13). Las entidades de Fase 2 y 3 del DER llegan con sus HU.
// Convención: nombres de tabla y columna en snake_case, en español; modelos en PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Plan contratado por el comercio (Propuesta v2.0 §4, RF-15).
enum Plan {
  FREE
  PRO
  PREMIUM

  @@map("plan")
}

/// Rol del usuario dentro de su comercio (Propuesta v2.0 §2.4).
enum Rol {
  DUENIO
  EMPLEADO
  CONTADOR

  @@map("rol")
}

/// Comercio: unidad de aislamiento multi-tenant (RNF-10).
model Comercio {
  id                  String   @id @default(uuid()) @db.Uuid
  nombre              String   @db.VarChar(120)
  cuit                String?  @db.VarChar(13)
  plan                Plan     @default(FREE)
  /// Alícuota de IVA por defecto para productos nuevos (RN-03), en porcentaje.
  ivaDefault          Decimal  @default(21) @map("iva_default") @db.Decimal(5, 2)
  moneda              String   @default("ARS") @db.Char(3)
  /// true hasta que el dueño confirma el nombre del comercio (POST /me/onboarding).
  onboardingPendiente Boolean  @default(true) @map("onboarding_pendiente")
  /// Último recálculo de alertas de reposición (HU-06); null si nunca corrió.
  alertasCalculadasEn DateTime? @map("alertas_calculadas_en") @db.Timestamptz(3)
  creadoEn            DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuarios    Usuario[]
  productos   Producto[]
  movimientos Movimiento[]
  proveedores Proveedor[]
  precios     PrecioProveedor[]
  gastos      Gasto[]
  alertas     Alerta[]

  @@map("comercio")
}

/// Producto del catálogo (HU-01). El stock sólo cambia por movimientos (RN-07).
/// costoReposicion es el costo vigente sin IVA; HU-02 lo actualiza desde listas de proveedores (RN-08).
model Producto {
  id                   String   @id @default(uuid()) @db.Uuid
  comercioId           String   @map("comercio_id") @db.Uuid
  codigo               String   @db.VarChar(64)
  /// upper(trim(codigo)): unicidad por comercio sin distinguir mayúsculas (RN-05).
  codigoNormalizado    String   @map("codigo_normalizado") @db.VarChar(64)
  nombre               String   @db.VarChar(120)
  categoria            String?  @db.VarChar(60)
  /// Precio de venta al público, con IVA incluido.
  precioVenta          Decimal  @map("precio_venta") @db.Decimal(14, 2)
  /// Alícuota de IVA en porcentaje (RN-03).
  alicuotaIva          Decimal  @map("alicuota_iva") @db.Decimal(5, 2)
  /// Costo de reposición vigente, sin IVA.
  costoReposicion      Decimal  @map("costo_reposicion") @db.Decimal(14, 2)
  stockActual          Int      @default(0) @map("stock_actual")
  stockSeguridad       Int      @default(0) @map("stock_seguridad")
  /// Días de anticipación de la alerta de reposición, 0 a 90 (HU-06 criterio 4; CHECK en la migración).
  diasAnticipacionAlerta Int    @default(3) @map("dias_anticipacion_alerta") @db.SmallInt
  /// Proveedor cuya última lista fija costoReposicion (RN-08, HU-02).
  proveedorPrincipalId String?  @map("proveedor_principal_id") @db.Uuid
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  comercio           Comercio          @relation(fields: [comercioId], references: [id])
  movimientos        Movimiento[]
  proveedorPrincipal Proveedor?        @relation("ProveedorPrincipal", fields: [proveedorPrincipalId], references: [id], onDelete: SetNull)
  precios            PrecioProveedor[]

  alertas            Alerta[]

  @@unique([comercioId, codigoNormalizado])
  @@index([comercioId, activo, nombre])
  @@index([proveedorPrincipalId])
  @@map("producto")
}

/// Usuario autenticado por Firebase; pertenece a un único comercio (RN-10).
/// firebaseUid nulo = invitación pendiente: se vincula cuando la persona inicia sesión con ese email.
model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  comercioId  String   @map("comercio_id") @db.Uuid
  firebaseUid String?  @unique @map("firebase_uid") @db.VarChar(128)
  email       String   @unique @db.VarChar(254)
  nombre      String?  @db.VarChar(120)
  rol         Rol      @default(DUENIO)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  comercio    Comercio          @relation(fields: [comercioId], references: [id])
  movimientos Movimiento[]
  precios     PrecioProveedor[]
  gastos      Gasto[]

  @@index([comercioId])
  @@map("usuario")
}

/// Tipo de gasto operativo (HU-13).
enum TipoGasto {
  FIJO
  VARIABLE

  @@map("tipo_gasto")
}

/// Periodicidad de un gasto: único en su mes, mensual desde su mes, anual prorrateado en doceavos.
enum PeriodicidadGasto {
  UNICO
  MENSUAL
  ANUAL

  @@map("periodicidad_gasto")
}

/// Gasto operativo del comercio (HU-13, RF-14). Importe neto sin IVA (RN-03).
/// periodo y fin son el primer día del mes (la API los expone como YYYY-MM).
model Gasto {
  id            String            @id @default(uuid()) @db.Uuid
  comercioId    String            @map("comercio_id") @db.Uuid
  concepto      String            @db.VarChar(120)
  tipo          TipoGasto
  importe       Decimal           @db.Decimal(14, 2)
  periodo       DateTime          @db.Date
  periodicidad  PeriodicidadGasto
  fin           DateTime?         @db.Date
  notas         String?           @db.VarChar(300)
  usuarioId     String            @map("usuario_id") @db.Uuid
  creadoEn      DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime          @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  comercio Comercio @relation(fields: [comercioId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([comercioId, periodo])
  @@map("gasto")
}

/// Origen de una fila de costo (HU-02).
enum OrigenPrecio {
  MANUAL
  IMPORT

  @@map("origen_precio")
}

/// Proveedor del comercio (HU-02, RF-03). lead_time_dias alimenta RN-04; confiabilidad, HU-12.
model Proveedor {
  id                String   @id @default(uuid()) @db.Uuid
  comercioId        String   @map("comercio_id") @db.Uuid
  nombre            String   @db.VarChar(120)
  /// upper(trim(nombre)): único por comercio sin distinguir mayúsculas.
  nombreNormalizado String   @map("nombre_normalizado") @db.VarChar(120)
  contacto          String?  @db.VarChar(120)
  email             String?  @db.VarChar(254)
  telefono          String?  @db.VarChar(40)
  cuit              String?  @db.VarChar(13)
  leadTimeDias      Int      @default(7) @map("lead_time_dias")
  /// 1 a 5 (CHECK en la migración).
  confiabilidad     Int      @default(3) @db.SmallInt
  notas             String?  @db.VarChar(500)
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  comercio             Comercio          @relation(fields: [comercioId], references: [id])
  precios              PrecioProveedor[]
  productosPrincipales Producto[]        @relation("ProveedorPrincipal")

  @@unique([comercioId, nombreNormalizado])
  @@index([comercioId, activo, nombre])
  @@map("proveedor")
}

/// Historial de costos por producto y proveedor: sólo inserción (RN-08).
/// El rol de la API no puede modificar ni borrar filas.
model PrecioProveedor {
  id           String       @id @default(uuid()) @db.Uuid
  comercioId   String       @map("comercio_id") @db.Uuid
  productoId   String       @map("producto_id") @db.Uuid
  proveedorId  String       @map("proveedor_id") @db.Uuid
  /// Costo neto sin IVA.
  costoNeto    Decimal      @map("costo_neto") @db.Decimal(14, 2)
  vigenteDesde DateTime     @default(now()) @map("vigente_desde") @db.Timestamptz(3)
  origen       OrigenPrecio
  /// Agrupa las filas de una misma importación.
  loteId       String?      @map("lote_id") @db.Uuid
  usuarioId    String       @map("usuario_id") @db.Uuid
  creadoEn     DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)

  comercio  Comercio  @relation(fields: [comercioId], references: [id])
  producto  Producto  @relation(fields: [productoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([comercioId, proveedorId, productoId, vigenteDesde(sort: Desc), creadoEn(sort: Desc)])
  @@index([comercioId, productoId, vigenteDesde(sort: Desc), id(sort: Desc)])
  @@map("precio_proveedor")
}

/// Tipo de movimiento de stock (HU-10, RF-13).
enum TipoMovimiento {
  VENTA
  INGRESO
  AJUSTE

  @@map("tipo_movimiento")
}

/// Motivo del movimiento. STOCK_INICIAL y ANULACION los asigna el sistema.
enum MotivoMovimiento {
  STOCK_INICIAL
  COMPRA
  DEVOLUCION
  INVENTARIO
  ROTURA
  VENCIMIENTO
  ROBO
  USO_INTERNO
  ANULACION
  OTRO

  @@map("motivo_movimiento")
}

/// Movimiento de stock: inmutable (RN-07). El rol de la API sólo puede insertar y
/// completar `anulado_por_id`; una corrección es un AJUSTE que referencia al original.
model Movimiento {
  id                String            @id @default(uuid()) @db.Uuid
  comercioId        String            @map("comercio_id") @db.Uuid
  productoId        String            @map("producto_id") @db.Uuid
  /// Quién lo registró (auditoría mínima).
  usuarioId         String            @map("usuario_id") @db.Uuid
  tipo              TipoMovimiento
  /// Como se registró: > 0 en VENTA e INGRESO; con signo en AJUSTE.
  cantidad          Int
  /// Delta aplicado a producto.stock_actual (nunca 0).
  efectoStock       Int               @map("efecto_stock")
  /// Stock del producto después de aplicar el movimiento (>= 0).
  stockResultante   Int               @map("stock_resultante")
  /// Sólo VENTA: precio de venta vigente (con IVA) al momento de vender.
  precioUnitario    Decimal?          @map("precio_unitario") @db.Decimal(14, 2)
  motivo            MotivoMovimiento?
  observacion       String?           @db.VarChar(200)
  /// Fecha del hecho; puede ser anterior a creado_en, nunca futura.
  fecha             DateTime          @default(now()) @db.Timestamptz(3)
  /// AJUSTE de anulación: id del movimiento que corrige.
  corrigeAId        String?           @unique @map("corrige_a_id") @db.Uuid
  /// Movimiento original: id del AJUSTE que lo anuló.
  anuladoPorId      String?           @unique @map("anulado_por_id") @db.Uuid
  /// Idempotency-Key del cliente, única por comercio.
  claveIdempotencia String?           @map("clave_idempotencia") @db.VarChar(64)
  creadoEn          DateTime          @default(now()) @map("creado_en") @db.Timestamptz(3)

  comercio     Comercio    @relation(fields: [comercioId], references: [id])
  producto     Producto    @relation(fields: [productoId], references: [id])
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  corrigeA     Movimiento? @relation("Correccion", fields: [corrigeAId], references: [id])
  corregidoPor Movimiento? @relation("Correccion")
  anuladoPor   Movimiento? @relation("Anulacion", fields: [anuladoPorId], references: [id])
  anula        Movimiento? @relation("Anulacion")

  @@unique([comercioId, claveIdempotencia])
  @@index([comercioId, fecha(sort: Desc), id(sort: Desc)])
  @@index([comercioId, productoId, fecha(sort: Desc), id(sort: Desc)])
  @@map("movimiento")
}

/// Alerta predictiva de reposición (HU-06, RN-04). A lo sumo una abierta por producto
/// (índice único parcial en la migración). No se borra: se cierra con RESUELTA o ATENDIDA.
model Alerta {
  id               String          @id @default(uuid()) @db.Uuid
  comercioId       String          @map("comercio_id") @db.Uuid
  productoId       String          @map("producto_id") @db.Uuid
  estado           EstadoAlerta    @default(ACTIVA)
  severidad        SeveridadAlerta
  /// Stock al momento del último cálculo.
  stock            Int
  velocidadDiaria  Decimal         @map("velocidad_diaria") @db.Decimal(10, 3)
  diasCobertura    Int?            @map("dias_cobertura")
  puntoReposicion  Int             @map("punto_reposicion")
  umbral           Int
  leadTimeDias     Int             @map("lead_time_dias")
  diasAnticipacion Int             @map("dias_anticipacion")
  cantidadSugerida Int             @map("cantidad_sugerida")
  generadaEn       DateTime        @default(now()) @map("generada_en") @db.Timestamptz(3)
  actualizadaEn    DateTime        @default(now()) @map("actualizada_en") @db.Timestamptz(3)
  pospuestaHasta   DateTime?       @map("pospuesta_hasta") @db.Timestamptz(3)
  atendidaEn       DateTime?       @map("atendida_en") @db.Timestamptz(3)
  resueltaEn       DateTime?       @map("resuelta_en") @db.Timestamptz(3)
  notificadaEn     DateTime?       @map("notificada_en") @db.Timestamptz(3)

  comercio Comercio @relation(fields: [comercioId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([comercioId, estado, diasCobertura])
  @@index([productoId])
  @@map("alerta")
}

enum EstadoAlerta {
  ACTIVA
  POSPUESTA
  ATENDIDA
  RESUELTA

  @@map("estado_alerta")
}

enum SeveridadAlerta {
  PROXIMA
  CRITICA

  @@map("severidad_alerta")
}
