// InventarioSmart — esquema de datos.
// Sprint 0: sólo Comercio (tenant) y Usuario. El resto de las entidades del DER
// (Producto, Proveedor, PrecioProveedor, Movimiento, Gasto, …) llegan con sus HU.
// Convención: nombres de tabla y columna en snake_case, en español; modelos en PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Plan contratado por el comercio (Propuesta v2.0 §4, RF-15).
enum Plan {
  FREE
  PRO
  PREMIUM

  @@map("plan")
}

/// Rol del usuario dentro de su comercio (Propuesta v2.0 §2.4).
enum Rol {
  DUENIO
  EMPLEADO
  CONTADOR

  @@map("rol")
}

/// Comercio: unidad de aislamiento multi-tenant (RNF-10).
model Comercio {
  id         String   @id @default(uuid()) @db.Uuid
  nombre     String   @db.VarChar(120)
  cuit       String?  @db.VarChar(13)
  plan       Plan     @default(FREE)
  /// Alícuota de IVA por defecto para productos nuevos (RN-03), en porcentaje.
  ivaDefault Decimal  @default(21) @map("iva_default") @db.Decimal(5, 2)
  moneda     String   @default("ARS") @db.Char(3)
  /// true hasta que el dueño confirma el nombre del comercio (POST /me/onboarding).
  onboardingPendiente Boolean @default(true) @map("onboarding_pendiente")
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuarios  Usuario[]
  productos Producto[]

  @@map("comercio")
}

/// Producto del catálogo (HU-01). El stock sólo cambia por movimientos (RN-07).
/// costoReposicion es el costo vigente sin IVA; HU-02 lo actualiza desde listas de proveedores (RN-08).
model Producto {
  id                String   @id @default(uuid()) @db.Uuid
  comercioId        String   @map("comercio_id") @db.Uuid
  codigo            String   @db.VarChar(64)
  /// upper(trim(codigo)): unicidad por comercio sin distinguir mayúsculas (RN-05).
  codigoNormalizado String   @map("codigo_normalizado") @db.VarChar(64)
  nombre            String   @db.VarChar(120)
  categoria         String?  @db.VarChar(60)
  /// Precio de venta al público, con IVA incluido.
  precioVenta       Decimal  @map("precio_venta") @db.Decimal(14, 2)
  /// Alícuota de IVA en porcentaje (RN-03).
  alicuotaIva       Decimal  @map("alicuota_iva") @db.Decimal(5, 2)
  /// Costo de reposición vigente, sin IVA.
  costoReposicion   Decimal  @map("costo_reposicion") @db.Decimal(14, 2)
  stockActual       Int      @default(0) @map("stock_actual")
  stockSeguridad    Int      @default(0) @map("stock_seguridad")
  activo            Boolean  @default(true)
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  comercio Comercio @relation(fields: [comercioId], references: [id])

  @@unique([comercioId, codigoNormalizado])
  @@index([comercioId, activo, nombre])
  @@map("producto")
}

/// Usuario autenticado por Firebase; pertenece a un único comercio (RN-10).
/// firebaseUid nulo = invitación pendiente: se vincula cuando la persona inicia sesión con ese email.
model Usuario {
  id          String   @id @default(uuid()) @db.Uuid
  comercioId  String   @map("comercio_id") @db.Uuid
  firebaseUid String?  @unique @map("firebase_uid") @db.VarChar(128)
  email       String   @unique @db.VarChar(254)
  nombre      String?  @db.VarChar(120)
  rol         Rol      @default(DUENIO)
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  comercio Comercio @relation(fields: [comercioId], references: [id])

  @@index([comercioId])
  @@map("usuario")
}
