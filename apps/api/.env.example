# Copiar a .env y completar. El archivo .env está ignorado por git.

# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL. En desarrollo apunta a la base local (PostgreSQL 18 instalado en la máquina).
# En Render: DATABASE_URL = cadena "pooled" de Neon y DIRECT_URL = cadena directa (migraciones).
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/inventariosmart_dev
DIRECT_URL=postgresql://postgres:CAMBIAR@localhost:5432/inventariosmart_dev

# Credencial del service account de Firebase, en base64 (ver docs/ARRANQUE.md).
# Vacío en NODE_ENV=test: los tests reemplazan el verificador de tokens por uno simulado.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Nivel de log de pino: trace | debug | info | warn | error
LOG_LEVEL=debug
