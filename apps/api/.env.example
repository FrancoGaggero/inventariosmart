# Copiar a .env y completar. El archivo .env está ignorado por git.

# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# PostgreSQL. En desarrollo se usa la rama `dev` de Neon (no hace falta base local):
#   DATABASE_URL = cadena "pooled" de la rama dev, DIRECT_URL = cadena directa (migraciones).
# En Render (producción) van las cadenas de la rama `production`.
DATABASE_URL=postgresql://neondb_owner:CAMBIAR@ep-xxxx-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:CAMBIAR@ep-xxxx.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Credencial del service account de Firebase, en base64 (ver docs/ARRANQUE.md).
# Vacío en NODE_ENV=test: los tests reemplazan el verificador de tokens por uno simulado.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Nivel de log de pino: trace | debug | info | warn | error
LOG_LEVEL=debug
